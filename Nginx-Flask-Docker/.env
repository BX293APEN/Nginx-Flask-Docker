# ==========================================
# .env : compose.yml内で利用する環境変数の設定
# ==========================================

# ==========================================
# プロジェクトの設定
# 
# | 項目 | 内容 | 備考 |
# | --- | --- | --- |
# | COMPOSE_PROJECT_NAME | プロジェクト名 | 全て小文字にすること |
# | VOLUME | コンテナ内でマウントするホストディレクトリ | - |
# | TIME_ZONE | コンテナのタイムゾーン | - |
# | LANG | コンテナのロケール | - |
# 
# ==========================================

COMPOSE_PROJECT_NAME=nginx-flask-docker

VOLUME=./linux_data

TIME_ZONE=Asia/Tokyo
LANG=ja_JP.UTF8

# ==========================================
# Nginx + Flask の設定 (nginx)
# 
# | 項目 | 内容 | 備考 |
# | --- | --- | --- |
# | NGINX_CONTAINER_NAME | コンテナ名 | 別コンテナ・外部からアクセスする際に使用する |
# | Dockerfile_DIR | Dockerfileがあるディレクトリ | 相対パス |
# | Dockerfile | Dockerfileの名前 | コンテナ起動時に使用 |
# | ENTRY_DIR | 作業用フォルダ | /${ENTRY_DIR} としてルート直下に作成する (権限問題) |
# | ENTRY_POINT | Dockerfileを使用後実行するスクリプト | - |
# | WS | 作業スペース | /${ENTRY_DIR}/${WS} にnginx一式(html/flask含む)をマウントする |
# | USER_NAME | nginx・Flaskを起動するユーザ名 | - |
# | PASSWORD | 上記ユーザのパスワード | - |
# | PORT | 外部からWebアプリにアクセスする際のポート番号 | http://(localhost|ホストのIPアドレス):${PORT} (80なら省略可) |
# | FLASK_PORT | Flask(gunicorn)の待受ポート (コンテナ内部のみ) | nginx.conf の proxy_pass と合わせること |
# | FLASK_WORKERS | gunicornのワーカー数 | - |
# 
# ==========================================

NGINX_CONTAINER_NAME=Docker_Nginx_Flask
Dockerfile_DIR=.
Dockerfile=Dockerfile

ENTRY_DIR=Programs
ENTRY_POINT=start.sh

WS=WS

USER_NAME=PEN
PASSWORD=password

PORT=80

FLASK_PORT=5000
FLASK_WORKERS=2
